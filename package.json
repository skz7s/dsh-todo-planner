{
  "name": "dsh-todo-planner",
  "version": "0.1.0",
  "description": "A Todo planning plugin and targeted web search enhancements for DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skz7s/dsh-todo-planner.git"
  },
  "homepage": "https://github.com/skz7s/dsh-todo-planner",
  "bugs": {
    "url": "https://github.com/skz7s/dsh-todo-planner/issues"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "todo", "planning", "productivity"],
  "main": "./src/plugins/dsh-todo-plugin.js",
  "exports": {
    ".": "./src/plugins/dsh-todo-plugin.js",
    "./client": "./src/dsh/client.js",
    "./typert": "./src/plugins/typert.host.js",
    "./remote": "./src/plugins/typert.remote.js",
    "./config": "./src/plugins/config.js",
    "./web-search": "./src/plugins/web-search.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/domain/todo.js && node --check src/domain/model-input.js && node --check src/storage/file-lock.js && node --check src/storage/todo-repository.js && node --check src/storage/usage-repository.js && node --check src/storage/settings-repository.js && node --check src/plugins/config.js && node --check src/plugins/dsh-todo-plugin.js && node --check src/plugins/model-defaults.js && node --check src/plugins/remote-schemas.js && node --check src/plugins/dsh-todo-planner-remotes.js && node --check src/plugins/typert.host.js && node --check src/plugins/typert.remote.js && node --check src/plugins/web-search.js && node --check src/dsh/client.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.87.1",
    "openai": "6.40.0",
    "zod": "^4.4.3"
  }
}
