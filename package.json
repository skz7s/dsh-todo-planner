{
  "name": "todo-harness",
  "version": "0.1.0",
  "description": "A Todo plugin and side panel for the native DeepSeek Harness web client.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "src",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": ["deepseek", "harness", "todo", "productivity", "plugin"],
  "main": "./src/plugins/dsh-todo-plugin.js",
  "exports": {
    ".": "./src/plugins/dsh-todo-plugin.js",
    "./client": "./src/dsh/client.js",
    "./typert": "./src/plugins/typert.host.js",
    "./remote": "./src/plugins/typert.remote.js",
    "./config": "./src/plugins/config.js",
    "./web-search": "./src/plugins/web-search.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node --watch src/cli.js",
    "desktop": "electron src/desktop/main.cjs",
    "test": "node --test",
    "check": "node --check src/desktop/main.cjs && node --check src/cli.js && node --check src/domain/todo.js && node --check src/domain/model-input.js && node --check src/storage/file-lock.js && node --check src/storage/todo-repository.js && node --check src/storage/usage-repository.js && node --check src/storage/settings-repository.js && node --check src/plugins/config.js && node --check src/plugins/todo-harness-store.js && node --check src/plugins/dsh-todo-plugin.js && node --check src/plugins/model-defaults.js && node --check src/plugins/remote-schemas.js && node --check src/plugins/todo-harness-remotes.js && node --check src/plugins/typert.host.js && node --check src/plugins/typert.remote.js && node --check src/plugins/web-search.js && node --check src/dsh/client.js && node --check src/http/server.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.87.1",
    "openai": "6.40.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "44.7.0"
  }
}
